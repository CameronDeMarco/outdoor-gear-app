# Non-secret config, safe to commit. Real secrets go in .env.local (gitignored).
#
# Local development database. Matches the Docker Postgres in the README.
# The Prisma CLI reads DATABASE_URL from this file. In production (Cloud Run)
# it is overridden by the DATABASE_URL secret from Secret Manager.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geariq"
